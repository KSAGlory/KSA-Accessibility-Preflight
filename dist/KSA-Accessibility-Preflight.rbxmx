        <string name="Name">Theme</string>
        <ProtectedString name="Source">--!strict

return {
	Background = Color3.fromRGB(16, 18, 23),
	Surface = Color3.fromRGB(25, 29, 37),
	SurfaceHover = Color3.fromRGB(31, 36, 46),
	Border = Color3.fromRGB(48, 55, 69),
	Text = Color3.fromRGB(239, 242, 247),
	Muted = Color3.fromRGB(154, 163, 179),
	Accent = Color3.fromRGB(120, 92, 255),
	Pass = Color3.fromRGB(67, 201, 142),
	High = Color3.fromRGB(255, 94, 105),
	Medium = Color3.fromRGB(255, 184, 77),
	Review = Color3.fromRGB(91, 171, 255),
}
</ProtectedString>
